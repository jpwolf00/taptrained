# Copy to .env.local for local dev. Set the same vars in Vercel for prod.
# Never commit .env.local. Anything without NEXT_PUBLIC_ stays server-side only.

# --- Supabase (added in the auth/DB step) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouter (AI: menu extraction + question generation) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default model for all AI calls. Override live from the admin AI-Settings
# picker once that's built; this is the fallback. Browse slugs/pricing at
# https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Model used specifically for reading menu PHOTOS (must be vision-capable).
# Defaults to OPENROUTER_MODEL if unset.
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash-lite

# Public site URL (used in OpenRouter headers; optional for local dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
